# Nome para configuração interna; health usa identificador público estável.
APP_NAME=Vapor Starter Kit

# Deve corresponder a --env / VAPOR_ENV. Padrão do Vapor: development.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

# Apenas sqlite é suportado nesta fase. Caminho relativo à raiz de execução.
DATABASE_DRIVER=
DATABASE_PATH=

# Reservadas para a Fase 3; ainda não são consumidas pela aplicação.
# Antes da autenticação, substitua por: 
openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=

LOG_LEVEL=
